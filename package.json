{
  "name": "@yildizpay/http-adapter",
  "version": "3.11.0",
  "description": "Enterprise-grade, zero-dependency HTTP adapter for Node.js with pluggable client abstractions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "lint:package": "publint --strict && attw --pack . --profile node16"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "adapter",
    "fetch",
    "s2s",
    "typescript",
    "interceptor",
    "circuit-breaker",
    "retry",
    "exponential-backoff",
    "resilience",
    "exception",
    "zero-dependency",
    "nodejs"
  ],
  "author": "Mevlüt Kural <mevlutkural35@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/yildizpay/http-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yildizpay/http-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/yildizpay/http-adapter/issues"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
