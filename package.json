{
  "name": "@yildizpay/http-adapter",
  "version": "3.6.1",
  "description": "Enterprise-grade, zero-dependency HTTP adapter for Node.js with pluggable client abstractions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:cov": "jest --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "adapter",
    "fetch",
    "s2s",
    "typescript",
    "interceptor",
    "circuit-breaker",
    "retry",
    "exponential-backoff",
    "resilience",
    "exception",
    "zero-dependency",
    "nodejs"
  ],
  "author": "Mevlüt Kural <mevlutkural35@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/yildizpay/http-adapter#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yildizpay/http-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/yildizpay/http-adapter/issues"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
